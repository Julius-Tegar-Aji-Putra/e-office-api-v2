generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator prismabox {
  provider                    = "prismabox"
  output                      = "../src/generated/prismabox"
  additionalProperties        = "true"
  inputModel                  = "true"
  typeboxImportDependencyName = "elysia"
  typeboxImportVariableName   = "t"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]

  @@map("role")
}

model Permission {
  id       String           @id @default(cuid())
  resource String
  action   String
  roles    RolePermission[]

  @@unique([resource, action])
  @@map("permission")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_role")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permission")
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  emailVerified      Boolean             @default(false)
  image              String?
  isAnonymous        Boolean?            @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  accounts           Account[]
  documentSignatures DocumentSignature[] @relation("SignatureOwner")
  createdLetters     LetterInstance[]    @relation("LetterCreator")
  logs               LetterLog[]         @relation("LogActor")
  mahasiswa          Mahasiswa?
  pegawai            Pegawai?
  savedSignatures    SavedSignature[]
  sessions           Session[]
  userRoles          UserRole[]

  @@map("user")
}

model Mahasiswa {
  id             String       @id @default(cuid())
  nim            String       @unique
  tahunMasuk     String
  noHp           String
  alamat         String?
  tempatLahir    String?
  tanggalLahir   DateTime?
  userId         String       @unique
  departemenId   String
  programStudiId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  departemen     Departemen   @relation(fields: [departemenId], references: [id])
  programStudi   ProgramStudi @relation(fields: [programStudiId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([departemenId])
  @@index([programStudiId])
  @@map("mahasiswa")
}

model Pegawai {
  id             String       @id @default(cuid())
  nip            String       @unique
  jabatan        String
  noHp           String?
  userId         String       @unique
  departemenId   String
  programStudiId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  departemen     Departemen   @relation(fields: [departemenId], references: [id])
  programStudi   ProgramStudi @relation(fields: [programStudiId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([departemenId])
  @@index([programStudiId])
  @@map("pegawai")
}

model Departemen {
  id           String         @id @default(cuid())
  name         String
  code         String         @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?
  mahasiswa    Mahasiswa[]
  pegawai      Pegawai[]
  programStudi ProgramStudi[]

  @@map("departemen")
}

model ProgramStudi {
  id           String      @id @default(cuid())
  name         String
  code         String      @unique
  jenjang      Jenjang     @default(S1)
  departemenId String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
  mahasiswa    Mahasiswa[]
  pegawai      Pegawai[]
  departemen   Departemen  @relation(fields: [departemenId], references: [id])

  @@index([departemenId])
  @@map("program_studi")
}

model SavedSignature {
  id        String        @id @default(cuid())
  userId    String
  type      SignatureType @default(UPLOAD)
  fileUrl   String
  fileName  String
  alias     String?       // Nama TTD (misal: "TTD Formal", "TTD Resmi")
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_signature")
}

model LetterType {
  id                  String           @id @default(cuid())
  name                String
  code                String           @unique
  description         String?
  category            LetterCategory   @default(UMUM)
  requiresPengantar   Boolean          @default(true)
  requiresDekanSign   Boolean          @default(true)
  requiresWadekSign   Boolean          @default(false)
  defaultTargetSigner String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?
  letterInstances     LetterInstance[]
  templates           LetterTemplate[]

  @@map("letter_type")
}

model LetterTemplate {
  id               String     @id @default(cuid())
  versionName      String     @map("version_name")
  schemaDefinition Json       @map("schema_definition")
  formFields       Json       @map("form_fields")
  contentTemplate  Json?      @map("content_template")
  letterTypeId     String     @map("letter_type_id")
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  letterType       LetterType @relation(fields: [letterTypeId], references: [id])

  @@index([letterTypeId])
  @@map("letter_template")
}

model LetterInstance {
  id                String             @id @default(cuid())
  submissionValues  Json
  status            LetterStatus       @default(SUBMITTED)
  currentActiveRole String?
  priority          Priority           @default(NORMAL)
  signatureConfig   Json?              // Array koordinat TTD dari frontend: [{ signerId, x, y, page }]
  contentHtml       String?            @db.Text // HTML hasil generate surat final
  letterTypeId      String
  createdById       String
  submittedAt       DateTime           @default(now())
  completedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  attachments       LetterAttachment[]
  documents         LetterDocument[]
  createdBy         User               @relation("LetterCreator", fields: [createdById], references: [id])
  letterType        LetterType         @relation(fields: [letterTypeId], references: [id])
  logs              LetterLog[]

  @@index([status])
  @@index([letterTypeId])
  @@index([createdById])
  @@index([currentActiveRole])
  @@map("letter_instance")
}

model LetterDocument {
  id               String              @id @default(cuid())
  letterInstanceId String
  type             DocumentType
  content          Json?
  tembusan         Json?
  nomorSurat       String?             @unique
  tanggalSurat     DateTime?
  perihal          String?
  isSigned         Boolean             @default(false)
  fileUrl          String?
  qrCodeUrl        String?
  // Legalisasi fields
  legalisasiStatus LegalisasiStatus    @default(PENDING)
  sealImageUrl     String?             // URL gambar stempel resmi
  barcodeData      String?             // Encrypted verification data
  readyToDistribute Boolean            @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  signatures       DocumentSignature[]
  letterInstance   LetterInstance      @relation(fields: [letterInstanceId], references: [id], onDelete: Cascade)

  @@unique([letterInstanceId, type])
  @@index([letterInstanceId])
  @@index([nomorSurat])
  @@map("letter_document")
}

model DocumentSignature {
  id              String           @id @default(cuid())
  documentId      String
  signerId        String
  signerRole      String
  signerName      String
  signerNip       String?
  signatureUrl    String?          // URL gambar TTD final (dari MinIO)
  status          SignatureStatus  @default(PENDING)
  signedAt        DateTime?
  notes           String?
  order           Int              @default(0)
  // Position data for signature placement on PDF
  positionX       Float?           // X coordinate on PDF (0-1 normalized)
  positionY       Float?           // Y coordinate on PDF (0-1 normalized)
  positionPage    Int?             // Page number for signature
  document        LetterDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signer          User             @relation("SignatureOwner", fields: [signerId], references: [id])

  @@unique([documentId, signerRole])
  @@index([documentId])
  @@index([signerId])
  @@map("document_signature")
}

model LetterLog {
  id               String         @id @default(cuid())
  letterInstanceId String
  actorId          String
  actorRole        String
  action           LogAction
  fromStatus       LetterStatus?
  toStatus         LetterStatus?
  targetRole       String?
  notes            String?
  metadata         Json?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime       @default(now())
  actor            User           @relation("LogActor", fields: [actorId], references: [id])
  letterInstance   LetterInstance @relation(fields: [letterInstanceId], references: [id], onDelete: Cascade)

  @@index([letterInstanceId])
  @@index([actorId])
  @@index([action])
  @@map("letter_log")
}

model LetterAttachment {
  id               String         @id @default(cuid())
  letterInstanceId String
  fileName         String
  storageName      String
  storagePath      String
  fileUrl          String?
  fileSize         Int?
  mimeType         String?
  description      String?
  uploadedById     String
  uploadedAt       DateTime       @default(now())
  letterInstance   LetterInstance @relation(fields: [letterInstanceId], references: [id], onDelete: Cascade)

  @@index([letterInstanceId])
  @@map("letter_attachment")
}

enum Jenjang {
  D3
  S1
  S2
  S3
}

enum SignatureType {
  UPLOAD
  HANDWRITING

  @@map("signature_type")
}

enum SignatureStatus {
  PENDING
  SIGNED
  REJECTED

  @@map("signature_status")
}

enum LetterCategory {
  AKADEMIK
  SUMBER_DAYA
  UMUM

  @@map("letter_category")
}

enum DocumentType {
  SURAT_PENGANTAR
  SURAT_KEPUTUSAN
  SURAT_TUGAS
  SURAT_TUGAS_TABEL

  @@map("document_type")
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("priority")
}

enum LogAction {
  SUBMIT
  RESUBMIT
  APPROVE
  REJECT
  RETURN
  DISPOSITION
  DRAFT_CREATE
  DRAFT_UPDATE
  VERIFY
  REQUEST_REVISION
  SIGN
  ASSIGN_NUMBER
  STAMP
  GENERATE_QR
  FINALIZE
  STATUS_CHANGE
  COMMENT

  @@map("log_action")
}

enum LetterStatus {
  SUBMITTED
  KAPRODI_REVIEW
  SURAT_PENGANTAR_DRAFT
  SURAT_PENGANTAR_REVIEW
  SURAT_PENGANTAR_SIGNED
  FAKULTAS_RECEIVED
  FAKULTAS_DISPOSITION
  FAKULTAS_DRAFTING
  FAKULTAS_VERIFICATION
  FAKULTAS_SIGNING
  UPA_NUMBERING
  UPA_STAMPING
  UPA_FINALIZING
  COMPLETED
  REJECTED
  CANCELLED

  @@map("letter_status")
}

enum LegalisasiStatus {
  PENDING          // Belum diproses UPA
  NOMOR_DIBERIKAN  // Nomor surat sudah diberikan
  STEMPEL_DIBERIKAN // Stempel sudah dibubuhkan
  QR_GENERATED     // QR Code sudah di-generate
  COMPLETED        // Semua proses legalisasi selesai

  @@map("legalisasi_status")
}
