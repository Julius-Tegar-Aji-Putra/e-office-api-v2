    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.0",
    "@sinclair/typebox": "^0.34.48",
    "@verrou/core": "^0.5.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.4.6",
