/**
 * Dashboard Routes
 * Unified dashboard endpoints per role
 * Base path: /api/dash
 * Section 4 Prompting.md: Spesifikasi Dashboard
 */

import { Elysia, t } from 'elysia';
import { authMiddleware, requireAuth } from '../middlewares/auth';
import { db } from '../db';
import { successResponse, errorResponse } from '../shared/utils/response.util';
import { ROLES } from '../shared/constants/roles';
import { STATUS, getDisplayStatus, STATUS_DISPLAY } from '../shared/constants/status';

// ============================================================================
// TYPES
// ============================================================================

interface DashboardUser {
  id: string;
  name: string;
  email: string;
  role: string;
  departemenId?: string;
}

interface DashboardFilters {
  status?: string;
  type?: 'masuk' | 'keluar';
  documentType?: string;
  dateFrom?: string;
  dateTo?: string;
  search?: string;
  page?: string;
  limit?: string;
}

interface DashboardColumn {
  key: string;
  label: string;
  sortable?: boolean;
}

interface DashboardItem {
  id: string;
  title: string;
  submitterName?: string;
  documentType: string;
  letterCategory?: string;
  nomorSurat?: string;
  date: Date;
  status: string;
  displayStatus: string;
  isWaiting: boolean;
  actions: string[];
}

interface DashboardResult {
  columns: DashboardColumn[];
  items: DashboardItem[];
  pagination: {
    page: number;
    limit: number;
    total: number;
    totalPages: number;
  };
  statistics: {
    total: number;
    pending: number;
    completed: number;
    waiting: number;
  };
  tabs?: { key: string; label: string; count: number }[];
}

// ============================================================================
// COLUMN DEFINITIONS PER ROLE
// ============================================================================

const COLUMNS = {
  // Lingkup Departemen
  MAHASISWA_DOSEN: [
    { key: 'title', label: 'Judul', sortable: true },
    { key: 'documentType', label: 'Tipe', sortable: true },
    { key: 'date', label: 'Tanggal', sortable: true },
    { key: 'status', label: 'Status', sortable: true },
    { key: 'actions', label: 'Aksi' },
  ],
  KETUA_PRODI: [
    { key: 'submitterName', label: 'Nama Pengaju', sortable: true },
    { key: 'title', label: 'Judul', sortable: true },
    { key: 'documentType', label: 'Tipe', sortable: true },
    { key: 'date', label: 'Tanggal', sortable: true },
    { key: 'status', label: 'Status', sortable: true },
    { key: 'actions', label: 'Aksi' },
  ],
  ADMIN_PRODI_KADEP: [
    { key: 'submitterName', label: 'Nama Pengaju', sortable: true },
    { key: 'title', label: 'Judul', sortable: true },
    { key: 'documentType', label: 'Tipe', sortable: true },
    { key: 'date', label: 'Tanggal', sortable: true },
    { key: 'status', label: 'Status', sortable: true },
    { key: 'actions', label: 'Aksi' },
  ],

  // Lingkup Fakultas - Surat Masuk
  FAKULTAS_MASUK: [
    { key: 'submitterName', label: 'Nama Pengaju', sortable: true },
    { key: 'title', label: 'Judul', sortable: true },
    { key: 'documentType', label: 'Tipe', sortable: true },
    { key: 'letterCategory', label: 'Jenis', sortable: true },
    { key: 'date', label: 'Tanggal', sortable: true },
    { key: 'status', label: 'Status', sortable: true },
    { key: 'actions', label: 'Aksi' },
  ],

  // Lingkup Fakultas - Surat Keluar
  FAKULTAS_KELUAR: [
    { key: 'title', label: 'Judul', sortable: true },
    { key: 'documentType', label: 'Tipe', sortable: true },
    { key: 'letterCategory', label: 'Jenis', sortable: true },
    { key: 'date', label: 'Tanggal', sortable: true },
    { key: 'status', label: 'Status', sortable: true },
    { key: 'actions', label: 'Aksi' },
  ],

  // UPA
  UPA: [
    { key: 'title', label: 'Judul', sortable: true },
    { key: 'nomorSurat', label: 'Nomor Surat', sortable: true },
    { key: 'documentType', label: 'Tipe', sortable: true },
    { key: 'letterCategory', label: 'Jenis', sortable: true },
    { key: 'date', label: 'Tanggal', sortable: true },
    { key: 'status', label: 'Status', sortable: true },
    { key: 'actions', label: 'Aksi' },
  ],
};

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

function getColumnsForRole(role: string, type?: 'masuk' | 'keluar'): DashboardColumn[] {
  switch (role) {
    case ROLES.MAHASISWA:
    case ROLES.DOSEN:
      return COLUMNS.MAHASISWA_DOSEN;

    case ROLES.KETUA_PRODI:
      return COLUMNS.KETUA_PRODI;

    case ROLES.ADMIN_PRODI:
    case ROLES.KETUA_DEPARTEMEN:
      return COLUMNS.ADMIN_PRODI_KADEP;

    case ROLES.ADMIN_FAKULTAS:
    case ROLES.DEKAN:
    case ROLES.WAKIL_DEKAN_1:
    case ROLES.WAKIL_DEKAN_2:
    case ROLES.MANAJER_TU:
    case ROLES.SUPERVISOR_AKADEMIK:
    case ROLES.SUPERVISOR_SUMBER_DAYA:
    case ROLES.STAF_AKADEMIK:
    case ROLES.STAF_SUMBER_DAYA:
      return type === 'masuk' ? COLUMNS.FAKULTAS_MASUK : COLUMNS.FAKULTAS_KELUAR;

    case ROLES.UPA:
      return COLUMNS.UPA;

    default:
      return COLUMNS.MAHASISWA_DOSEN;
  }
}

function getActionsForItem(role: string, status: string, letterCategory?: string): string[] {
  const actions: string[] = ['view'];

  switch (role) {
    case ROLES.MAHASISWA:
    case ROLES.DOSEN:
      if (status === STATUS.COMPLETED) {
        actions.push('download');
      }
      break;

    case ROLES.KETUA_PRODI:
      if (status === STATUS.SUBMITTED) {
        actions.push('approve', 'reject');
      }
      if (status === STATUS.SURAT_PENGANTAR_SIGNED) {
        actions.push('sign');
      }
      break;

    case ROLES.ADMIN_PRODI:
      if (status === STATUS.SURAT_PENGANTAR_PENDING) {
        actions.push('draft');
      }
      break;

    case ROLES.KETUA_DEPARTEMEN:
      if (status === STATUS.SURAT_PENGANTAR_SIGNED) {
        actions.push('sign');
      }
      break;

    case ROLES.ADMIN_FAKULTAS:
      if (status === STATUS.FAKULTAS_RECEIVED) {
        actions.push('assign', 'forward');
      }
      break;

    case ROLES.DEKAN:
    case ROLES.WAKIL_DEKAN_1:
    case ROLES.WAKIL_DEKAN_2:
    case ROLES.MANAJER_TU:
    case ROLES.SUPERVISOR_AKADEMIK:
    case ROLES.SUPERVISOR_SUMBER_DAYA:
      if (status === STATUS.FAKULTAS_DISPOSITION) {
        actions.push('disposisi', 'selesai', 'kembalikan');
      }
      if (status === STATUS.FAKULTAS_VERIFICATION) {
        actions.push('verify', 'sign', 'kembalikan');
      }
      break;

    case ROLES.STAF_AKADEMIK:
    case ROLES.STAF_SUMBER_DAYA:
      if (status === STATUS.FAKULTAS_DRAFTING) {
        actions.push('draft', 'verify');
      }
      break;

    case ROLES.UPA:
      if (status === STATUS.UPA_PROCESSING) {
        actions.push('penomoran', 'legalisasi', 'terbitkan');
      }
      break;
  }

  return actions;
}

function isWaitingForUser(role: string, status: string, currentHandler?: string, userId?: string): boolean {
  // Check if the current status requires this role's action
  switch (role) {
    case ROLES.KETUA_PRODI:
      return status === STATUS.SUBMITTED || status === STATUS.SURAT_PENGANTAR_SIGNED;

    case ROLES.ADMIN_PRODI:
      return status === STATUS.SURAT_PENGANTAR_PENDING;

    case ROLES.KETUA_DEPARTEMEN:
      return status === STATUS.SURAT_PENGANTAR_SIGNED;

    case ROLES.ADMIN_FAKULTAS:
      return status === STATUS.SURAT_PENGANTAR_SIGNED || status === STATUS.FAKULTAS_RECEIVED;

    case ROLES.DEKAN:
    case ROLES.WAKIL_DEKAN_1:
    case ROLES.WAKIL_DEKAN_2:
    case ROLES.MANAJER_TU:
    case ROLES.SUPERVISOR_AKADEMIK:
    case ROLES.SUPERVISOR_SUMBER_DAYA:
      return (
        (status === STATUS.FAKULTAS_DISPOSITION || status === STATUS.FAKULTAS_VERIFICATION) &&
        currentHandler === userId
      );

    case ROLES.STAF_AKADEMIK:
    case ROLES.STAF_SUMBER_DAYA:
      return status === STATUS.FAKULTAS_DRAFTING && currentHandler === userId;

    case ROLES.UPA:
      return status === STATUS.UPA_PROCESSING;

    default:
      return false;
  }
}

// ============================================================================
// DASHBOARD QUERY BUILDERS
// ============================================================================

async function getDashboardForPengaju(
  user: DashboardUser,
  filters: DashboardFilters
): Promise<DashboardResult> {
  const page = filters.page ? parseInt(filters.page, 10) : 1;
  const limit = filters.limit ? parseInt(filters.limit, 10) : 20;
  const offset = (page - 1) * limit;

  // Build where clause
  const where: any = {
    submittedById: user.id,
  };

  if (filters.status) {
    where.status = filters.status;
  }

  if (filters.documentType) {
    where.documentType = {
      name: filters.documentType,
    };
  }

  if (filters.dateFrom || filters.dateTo) {
    where.createdAt = {};
    if (filters.dateFrom) where.createdAt.gte = new Date(filters.dateFrom);
    if (filters.dateTo) where.createdAt.lte = new Date(filters.dateTo);
  }

  if (filters.search) {
    where.OR = [
      { letterDocument: { content: { path: ['perihal'], string_contains: filters.search } } },
    ];
  }

  // Get items
  const [items, total] = await Promise.all([
    db.letterInstance.findMany({
      where,
      include: {
        documentType: true,
        letterDocument: true,
        letterCategory: true,
      },
      orderBy: { createdAt: 'desc' },
      skip: offset,
      take: limit,
    }),
    db.letterInstance.count({ where }),
  ]);

  // Get statistics
  const [pending, completed] = await Promise.all([
    db.letterInstance.count({
      where: {
        submittedById: user.id,
        status: { notIn: [STATUS.COMPLETED, STATUS.REJECTED, STATUS.RETURNED] },
      },
    }),
    db.letterInstance.count({
      where: {
        submittedById: user.id,
        status: STATUS.COMPLETED,
      },
    }),
  ]);

  // Map items
  const mappedItems: DashboardItem[] = items.map((item) => ({
    id: item.id,
    title: (item.letterDocument?.content as any)?.perihal || 'Untitled',
    documentType: item.documentType?.name || '-',
    letterCategory: item.letterCategory?.name,
    date: item.createdAt,
    status: item.status,
    displayStatus: getDisplayStatus(item.status, user.role),
    isWaiting: false,
    actions: getActionsForItem(user.role, item.status),
  }));

  return {
    columns: getColumnsForRole(user.role),
    items: mappedItems,
    pagination: {
      page,
      limit,
      total,
      totalPages: Math.ceil(total / limit),
    },
    statistics: {
      total,
      pending,
      completed,
      waiting: 0,
    },
  };
}

async function getDashboardForDepartemen(
  user: DashboardUser,
  filters: DashboardFilters
): Promise<DashboardResult> {
  const page = filters.page ? parseInt(filters.page, 10) : 1;
  const limit = filters.limit ? parseInt(filters.limit, 10) : 20;
  const offset = (page - 1) * limit;

  // Build where clause based on role
  const where: any = {
    departemenId: user.departemenId,
  };

  // Filter by status that this role can see
  switch (user.role) {
    case ROLES.KETUA_PRODI:
      where.OR = [
        { status: STATUS.SUBMITTED },
        { status: STATUS.SURAT_PENGANTAR_SIGNED },
        { status: STATUS.KAPRODI_APPROVED },
      ];
      break;

    case ROLES.ADMIN_PRODI:
      where.OR = [
        { status: STATUS.SURAT_PENGANTAR_PENDING },
        { status: STATUS.KAPRODI_APPROVED },
      ];
      break;

    case ROLES.KETUA_DEPARTEMEN:
      where.OR = [
        { status: STATUS.SURAT_PENGANTAR_SIGNED },
      ];
      break;
  }

  if (filters.status) {
    where.status = filters.status;
  }

  if (filters.dateFrom || filters.dateTo) {
    where.createdAt = {};
    if (filters.dateFrom) where.createdAt.gte = new Date(filters.dateFrom);
    if (filters.dateTo) where.createdAt.lte = new Date(filters.dateTo);
  }

  // Get items
  const [items, total] = await Promise.all([
    db.letterInstance.findMany({
      where,
      include: {
        documentType: true,
        letterDocument: true,
        letterCategory: true,
        submittedBy: { select: { id: true, name: true, email: true } },
      },
      orderBy: { createdAt: 'desc' },
      skip: offset,
      take: limit,
    }),
    db.letterInstance.count({ where }),
  ]);

  // Get waiting count
  const waiting = items.filter((item) =>
    isWaitingForUser(user.role, item.status, item.currentHandlerId || undefined, user.id)
  ).length;

  // Map items
  const mappedItems: DashboardItem[] = items.map((item) => ({
    id: item.id,
    title: (item.letterDocument?.content as any)?.perihal || 'Untitled',
    submitterName: item.submittedBy?.name,
    documentType: item.documentType?.name || '-',
    letterCategory: item.letterCategory?.name,
    date: item.createdAt,
    status: item.status,
    displayStatus: getDisplayStatus(item.status, user.role),
    isWaiting: isWaitingForUser(user.role, item.status, item.currentHandlerId || undefined, user.id),
    actions: getActionsForItem(user.role, item.status, item.letterCategory?.name),
  }));

  return {
    columns: getColumnsForRole(user.role),
    items: mappedItems,
    pagination: {
      page,
      limit,
      total,
      totalPages: Math.ceil(total / limit),
    },
    statistics: {
      total,
      pending: total - items.filter((i) => i.status === STATUS.COMPLETED).length,
      completed: items.filter((i) => i.status === STATUS.COMPLETED).length,
      waiting,
    },
  };
}

async function getDashboardForFakultas(
  user: DashboardUser,
  filters: DashboardFilters
): Promise<DashboardResult> {
  const page = filters.page ? parseInt(filters.page, 10) : 1;
  const limit = filters.limit ? parseInt(filters.limit, 10) : 20;
  const offset = (page - 1) * limit;
  const type = filters.type || 'masuk';

  // Build where clause
  const where: any = {};

  if (type === 'masuk') {
    // Surat Masuk = Surat Pengantar yang masuk ke fakultas
    where.status = {
      in: [
        STATUS.SURAT_PENGANTAR_SIGNED,
        STATUS.FAKULTAS_RECEIVED,
        STATUS.FAKULTAS_DISPOSITION,
      ],
    };

    // Filter by current handler for pejabat
    if (
      [
        ROLES.DEKAN,
        ROLES.WAKIL_DEKAN_1,
        ROLES.WAKIL_DEKAN_2,
        ROLES.MANAJER_TU,
        ROLES.SUPERVISOR_AKADEMIK,
        ROLES.SUPERVISOR_SUMBER_DAYA,
      ].includes(user.role as any)
    ) {
      where.OR = [
        { currentHandlerId: user.id },
        { status: STATUS.FAKULTAS_RECEIVED },
      ];
    }
  } else {
    // Surat Keluar = Surat Hasil (ST/SK)
    where.letterDocumentId = { not: null };
    where.status = {
      in: [
        STATUS.FAKULTAS_DRAFTING,
        STATUS.FAKULTAS_VERIFICATION,
        STATUS.UPA_PROCESSING,
        STATUS.COMPLETED,
      ],
    };

    // Filter by current handler for staf/pejabat
    if (
      [
        ROLES.STAF_AKADEMIK,
        ROLES.STAF_SUMBER_DAYA,
        ROLES.SUPERVISOR_AKADEMIK,
        ROLES.SUPERVISOR_SUMBER_DAYA,
        ROLES.MANAJER_TU,
        ROLES.WAKIL_DEKAN_1,
        ROLES.WAKIL_DEKAN_2,
        ROLES.DEKAN,
      ].includes(user.role as any)
    ) {
      where.OR = [
        { currentHandlerId: user.id },
        { status: STATUS.FAKULTAS_VERIFICATION },
      ];
    }
  }

  if (filters.status) {
    where.status = filters.status;
  }

  if (filters.dateFrom || filters.dateTo) {
    where.createdAt = {};
    if (filters.dateFrom) where.createdAt.gte = new Date(filters.dateFrom);
    if (filters.dateTo) where.createdAt.lte = new Date(filters.dateTo);
  }

  // Get items
  const [items, total, masukCount, keluarCount] = await Promise.all([
    db.letterInstance.findMany({
      where,
      include: {
        documentType: true,
        letterDocument: true,
        letterCategory: true,
        submittedBy: { select: { id: true, name: true, email: true } },
      },
      orderBy: { createdAt: 'desc' },
      skip: offset,
      take: limit,
    }),
    db.letterInstance.count({ where }),
    db.letterInstance.count({
      where: {
        status: {
          in: [STATUS.SURAT_PENGANTAR_SIGNED, STATUS.FAKULTAS_RECEIVED, STATUS.FAKULTAS_DISPOSITION],
        },
      },
    }),
    db.letterInstance.count({
      where: {
        letterDocumentId: { not: null },
        status: {
          in: [STATUS.FAKULTAS_DRAFTING, STATUS.FAKULTAS_VERIFICATION, STATUS.UPA_PROCESSING, STATUS.COMPLETED],
        },
      },
    }),
  ]);

  // Get waiting count
  const waiting = items.filter((item) =>
    isWaitingForUser(user.role, item.status, item.currentHandlerId || undefined, user.id)
  ).length;

  // Map items
  const mappedItems: DashboardItem[] = items.map((item) => ({
    id: item.id,
    title: (item.letterDocument?.content as any)?.perihal || 'Untitled',
    submitterName: item.submittedBy?.name,
    documentType: item.documentType?.name || '-',
    letterCategory: item.letterCategory?.name,
    date: item.createdAt,
    status: item.status,
    displayStatus: getDisplayStatus(item.status, user.role),
    isWaiting: isWaitingForUser(user.role, item.status, item.currentHandlerId || undefined, user.id),
    actions: getActionsForItem(user.role, item.status, item.letterCategory?.name),
  }));

  return {
    columns: getColumnsForRole(user.role, type),
    items: mappedItems,
    pagination: {
      page,
      limit,
      total,
      totalPages: Math.ceil(total / limit),
    },
    statistics: {
      total,
      pending: total - items.filter((i) => i.status === STATUS.COMPLETED).length,
      completed: items.filter((i) => i.status === STATUS.COMPLETED).length,
      waiting,
    },
    tabs: [
      { key: 'masuk', label: 'Surat Masuk', count: masukCount },
      { key: 'keluar', label: 'Surat Keluar', count: keluarCount },
    ],
  };
}

async function getDashboardForUPA(
  user: DashboardUser,
  filters: DashboardFilters
): Promise<DashboardResult> {
  const page = filters.page ? parseInt(filters.page, 10) : 1;
  const limit = filters.limit ? parseInt(filters.limit, 10) : 20;
  const offset = (page - 1) * limit;

  // Build where clause
  const where: any = {
    status: STATUS.UPA_PROCESSING,
  };

  if (filters.status) {
    where.status = filters.status;
  }

  if (filters.dateFrom || filters.dateTo) {
    where.createdAt = {};
    if (filters.dateFrom) where.createdAt.gte = new Date(filters.dateFrom);
    if (filters.dateTo) where.createdAt.lte = new Date(filters.dateTo);
  }

  // Get items
  const [items, total, pendingPenomoran, pendingLegalisasi, completed] = await Promise.all([
    db.letterInstance.findMany({
      where,
      include: {
        documentType: true,
        letterDocument: true,
        letterCategory: true,
      },
      orderBy: { createdAt: 'desc' },
      skip: offset,
      take: limit,
    }),
    db.letterInstance.count({ where }),
    db.letterInstance.count({
      where: {
        status: STATUS.UPA_PROCESSING,
        nomorSurat: null,
      },
    }),
    db.letterInstance.count({
      where: {
        status: STATUS.UPA_PROCESSING,
        nomorSurat: { not: null },
        // isLegalized: false, // This field might not exist yet
      },
    }),
    db.letterInstance.count({
      where: {
        status: STATUS.COMPLETED,
        completedAt: {
          gte: new Date(new Date().getFullYear(), new Date().getMonth(), 1),
        },
      },
    }),
  ]);

  // Map items
  const mappedItems: DashboardItem[] = items.map((item) => ({
    id: item.id,
    title: (item.letterDocument?.content as any)?.perihal || 'Untitled',
    nomorSurat: item.nomorSurat || '-',
    documentType: item.documentType?.name || '-',
    letterCategory: item.letterCategory?.name,
    date: item.createdAt,
    status: item.status,
    displayStatus: getDisplayStatus(item.status, user.role),
    isWaiting: true,
    actions: getActionsForItem(user.role, item.status),
  }));

  return {
    columns: getColumnsForRole(user.role),
    items: mappedItems,
    pagination: {
      page,
      limit,
      total,
      totalPages: Math.ceil(total / limit),
    },
    statistics: {
      total,
      pending: pendingPenomoran + pendingLegalisasi,
      completed,
      waiting: total,
    },
  };
}

// ============================================================================
// MAIN DASHBOARD HANDLER
// ============================================================================

async function getDashboard(context: any) {
  try {
    const user = context.store?.user as DashboardUser;
    if (!user) {
      return errorResponse(context, 401, 'Unauthorized');
    }

    const filters = context.query as DashboardFilters;

    let result: DashboardResult;

    // Route to appropriate dashboard based on role
    switch (user.role) {
      case ROLES.MAHASISWA:
      case ROLES.DOSEN:
        result = await getDashboardForPengaju(user, filters);
        break;

      case ROLES.KETUA_PRODI:
      case ROLES.ADMIN_PRODI:
      case ROLES.KETUA_DEPARTEMEN:
        result = await getDashboardForDepartemen(user, filters);
        break;

      case ROLES.ADMIN_FAKULTAS:
      case ROLES.DEKAN:
      case ROLES.WAKIL_DEKAN_1:
      case ROLES.WAKIL_DEKAN_2:
      case ROLES.MANAJER_TU:
      case ROLES.SUPERVISOR_AKADEMIK:
      case ROLES.SUPERVISOR_SUMBER_DAYA:
      case ROLES.STAF_AKADEMIK:
      case ROLES.STAF_SUMBER_DAYA:
        result = await getDashboardForFakultas(user, filters);
        break;

      case ROLES.UPA:
        result = await getDashboardForUPA(user, filters);
        break;

      default:
        result = await getDashboardForPengaju(user, filters);
    }

    return successResponse(context, 'Berhasil mengambil dashboard', result);
  } catch (error: any) {
    console.error('Dashboard error:', error);
    return errorResponse(context, error.status || 500, error.message);
  }
}

// ============================================================================
// DASHBOARD ROUTES
// ============================================================================

export default new Elysia({ prefix: '/dash' })
  .use(authMiddleware)
  .guard({
    beforeHandle: [requireAuth],
  })

  /**
   * GET /api/dash
   * Get unified dashboard based on user role
   */
  .get('/', getDashboard, {
    query: t.Object({
      status: t.Optional(t.String()),
      type: t.Optional(t.Union([t.Literal('masuk'), t.Literal('keluar')])),
      documentType: t.Optional(t.String()),
      dateFrom: t.Optional(t.String()),
      dateTo: t.Optional(t.String()),
      search: t.Optional(t.String()),
      page: t.Optional(t.String()),
      limit: t.Optional(t.String()),
    }),
    detail: {
      tags: ['Dashboard'],
      summary: 'Get unified dashboard',
      description: 'Mengambil dashboard sesuai role user dengan filter dan statistik',
    },
  })

  /**
   * GET /api/dash/statistics
   * Get dashboard statistics only
   */
  .get('/statistics', async (context: any) => {
    try {
      const user = context.store?.user as DashboardUser;
      if (!user) {
        return errorResponse(context, 401, 'Unauthorized');
      }

      // Get basic statistics
      const [total, pending, completed, thisMonth] = await Promise.all([
        db.letterInstance.count(),
        db.letterInstance.count({
          where: {
            status: { notIn: [STATUS.COMPLETED, STATUS.REJECTED] },
          },
        }),
        db.letterInstance.count({
          where: { status: STATUS.COMPLETED },
        }),
        db.letterInstance.count({
          where: {
            createdAt: {
              gte: new Date(new Date().getFullYear(), new Date().getMonth(), 1),
            },
          },
        }),
      ]);

      return successResponse(context, 'Berhasil mengambil statistik', {
        total,
        pending,
        completed,
        thisMonth,
        role: user.role,
      });
    } catch (error: any) {
      return errorResponse(context, error.status || 500, error.message);
    }
  }, {
    detail: {
      tags: ['Dashboard'],
      summary: 'Get dashboard statistics',
      description: 'Mengambil statistik dashboard',
    },
  })

  /**
   * GET /api/dash/recent
   * Get recent activities
   */
  .get('/recent', async (context: any) => {
    try {
      const user = context.store?.user as DashboardUser;
      if (!user) {
        return errorResponse(context, 401, 'Unauthorized');
      }

      // Get recent logs
      const recentLogs = await db.letterLog.findMany({
        include: {
          letterInstance: {
            include: {
              documentType: true,
            },
          },
          actor: {
            select: { id: true, name: true },
          },
        },
        orderBy: { createdAt: 'desc' },
        take: 10,
      });

      const activities = recentLogs.map((log) => ({
        id: log.id,
        action: log.action,
        description: log.description,
        letterTitle: (log.letterInstance as any)?.letterDocument?.content?.perihal || 'Untitled',
        documentType: log.letterInstance?.documentType?.name,
        actorName: log.actor?.name,
        timestamp: log.createdAt,
      }));

      return successResponse(context, 'Berhasil mengambil aktivitas terbaru', activities);
    } catch (error: any) {
      return errorResponse(context, error.status || 500, error.message);
    }
  }, {
    detail: {
      tags: ['Dashboard'],
      summary: 'Get recent activities',
      description: 'Mengambil aktivitas terbaru',
    },
  });
