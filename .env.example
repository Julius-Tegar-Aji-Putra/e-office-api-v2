# --- 1. CONFIG APLIKASI ---
NODE_ENV=development
PORT=3079
BASE_URL=http://localhost:3079

# --- 2. DATABASE CONFIG ---
# Sesuaikan dengan user/pass yang ada di docker-compose.dev.yml
DATABASE_URL="postgresql://e-office-api-v2:password123@localhost:5433/e-office-api-v2?schema=public"

# --- 3. MINIO CONFIG ---
# Mengarah ke localhost karena Docker MinIO jalan di laptop sendiri
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
# Bucket ini otomatis dibuat oleh container 'createbuckets'
MINIO_BUCKET_NAME="e-office-storage"
MINIO_REGION="us-east-1"
MINIO_USE_SSL="false"

# Nama folder di dalam bucket
MINIO_FOLDER_LAMPIRAN='lampiran'
MINIO_FOLDER_SIGNATURE='signature'
MINIO_EXPIRY_URL=604800

# --- 4. KEAMANAN & LAINNYA ---
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
DEFAULT_PASSWORD='pagidatangsorehilang'
AVATAR_DEFAULT="https://gw.alipayobjects.com/zos/rmsportal/BiazfanxmamNRoxxVxka.png"
SSO_URL="https://apps-fsm.undip.ac.id/sso_api/"

# --- 5. ENKRIPSI & VERIFIKASI QR CODE ---
# Kunci enkripsi AES (minimal 32 karakter, jangan share ke publik!)
# Generate random: node -e "console.log(require('crypto').randomBytes(32).toString('base64').slice(0,32))"
APP_KEY="your-32-character-secret-key-here"
# Base URL untuk link verifikasi QR Code
VERIFICATION_BASE_URL="https://e-office.undip.ac.id"

# --- 6. EMAIL (Opsional - Bisa diaktifkan nanti) ---
MAIL_ENABLED=true
MAIL_FROM="Persuratan FSM <your-email@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-smtp-app-password

# ====================================
# EMAIL CONFIGURATION (Optional)
# ====================================
# For sending notification emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@e-office.com
